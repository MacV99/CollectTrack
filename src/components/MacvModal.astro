  <div class="modal-backdrop" id="modalBackdrop" onclick="closeModal()"></div>
  <div class="modal" id="modal">
    <div class="modal-header">
      <span class="modal-title" id="modalTitle">Nuevo cobro</span>
      <button class="modal-close" onclick="closeModal()">✕</button>
    </div>
    <div class="modal-body">
      <div class="form-group" id="fieldName">
        <label class="form-label">Nombre</label>
        <input class="form-control" id="fName" type="text" placeholder="Nombre del cliente" autocomplete="off" />
      </div>
      <div class="form-group">
        <label class="form-label">Categoría</label>
        <div class="combo">
          <input class="form-control" id="fCategory" type="text"
            placeholder="Selecciona o crea una categoría…" autocomplete="off" />
          <div class="combo-pop"></div>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Monto</label>
        <input class="form-control" id="fAmount" type="text" inputmode="numeric" placeholder="ej: 14.000" oninput="fmtAmountInput(this)" />
      </div>
      <div class="form-group">
        <label class="form-label">Día del mes</label>
        <input class="form-control" id="fDate" type="number" placeholder="ej: 15" min="1" max="31" />
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn-cancel" onclick="closeModal()">Cancelar</button>
      <button class="btn-save" id="btnSave" onclick="submitModal()">Guardar</button>
    </div>
  </div>

  <div id="notif-pill"></div>
