<!-- Central de cobros dentro de MACV → Cobros: conectar sistemas y pagos por
     confirmar (la lista y sus plazos están en CobrosPanel).
     Lógica en src/scripts/features/cobros.js. Estilos en project.css (.cob-*). -->

<!-- Clave del panel de cobros (se pide una vez y queda guardada en este equipo) -->
<div class="panel cob-conectar" id="cobConectar" hidden>
  <span class="cob-muted">Conecta tus sistemas (MesaDirecta…) con la clave del panel de cobros.</span>
  <input class="form-control" id="cobClave" type="password" autocomplete="off" placeholder="Clave" onkeydown="if(event.key==='Enter')cobEntrar()" />
  <button class="btn-add" onclick="cobEntrar()">Conectar</button>
  <span class="auth-err" id="cobLoginErr"></span>
</div>

<div class="panel" id="cobReportesPanel" hidden>
  <div class="panel-head">
    <span class="panel-title">Pagos por confirmar</span>
    <span class="row-count"><b id="cobReportesN">0</b> pendientes</span>
  </div>
  <div class="table-scroll">
    <table>
      <tbody id="cobReportes"></tbody>
    </table>
  </div>
</div>
