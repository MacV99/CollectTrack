---
import '../styles/global.css';
import '../styles/project.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CollectTrack</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#13e7c3" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="CollectTrack" />
    <link rel="apple-touch-icon" href="/icon.svg" />
    <link
      rel="icon"
      href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='7' fill='%2313e7c3'/><line x1='16' y1='5' x2='16' y2='27' stroke='%23080808' stroke-width='3' stroke-linecap='round'/><path d='M21 9H13.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H10' stroke='%23080808' stroke-width='3' stroke-linecap='round' fill='none'/></svg>"
    />
  </head>
  <body>
    <!-- Rol activo aplicado ANTES de pintar: evita que el socio vea MACV
         un instante. role-none => se muestra el login (ver project.css). -->
    <script is:inline>
      (function () {
        var r;
        try { r = localStorage.getItem('ct_role'); } catch (e) { r = null; }
        document.documentElement.classList.add(
          r === 'admin' || r === 'socio' ? 'role-' + r : 'role-none'
        );
      })();
    </script>

    <slot />

    <script>
      // Registro del service worker generado por @vite-pwa/astro.
      import { registerSW } from 'virtual:pwa-register';
      registerSW({ immediate: true });
    </script>
  </body>
</html>
