---
// Página pública de pago de la mensualidad (cualquier sistema).
// El sistema del cliente abre /pagar?t=ENLACE (lo pide a la central con
// action=enlacePago). No usa Layout.astro: no lleva el login por PIN.
import '../styles/global.css';
import '../styles/project.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>Pagar mensualidad</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta name="theme-color" content="#13e7c3" />
  </head>
  <body>
    <main class="pago-page">
      <div class="logo">
        <div class="logo-mark">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#06090f" stroke-width="2.5"
            stroke-linecap="round" stroke-linejoin="round">
            <line x1="12" y1="1" x2="12" y2="23" />
            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6" />
          </svg>
        </div>
        <span class="logo-name">Pagar <em>mensualidad</em></span>
      </div>

      <div class="pago-card" id="pagoCard">
        <p class="pago-sub">Cargando…</p>
      </div>
    </main>
    <div id="notif-pill"></div>

    <script>
      import '../scripts/pagar.js';
    </script>
  </body>
</html>
